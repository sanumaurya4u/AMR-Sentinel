# ==============================================================================
# AMR Sentinel AI — Backend Environment Variables
# Copy this file to `services/api/.env`
# ==============================================================================

# Server Runtime
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Allowed Origins (Comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Server Configuration
SUPABASE_URL=https://oqtgkptpmxldkxwybtls.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Assistive Edge Extraction (Optional: Gemini 2.5 Flash for OCR)
# If left empty, the system automatically uses the offline heuristic extractor
GEMINI_API_KEY=your_gemini_api_key_here

# Clinical Rules Engine Versioning
ACTIVE_RULE_SET_VERSION=1.0.0-ICMR-STG-2022
DEMO_MODE=true
